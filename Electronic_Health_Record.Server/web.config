<?xml version="1.0" encoding="utf-8"?>
<!--
  Only used when the published app is hosted behind IIS. A local `dotnet run`
  is served by Kestrel directly and never reads this file, which is why the
  problem this fixes only ever showed up in production.

  Without the two <remove> elements below, IIS answers every DELETE and PUT
  with 405 Method Not Allowed before the request reaches ASP.NET Core: the
  WebDAV module claims those verbs for itself during the module stage, which
  runs ahead of the handler stage where aspNetCore lives. The controller
  action is never invoked and nothing appears in the app's own logs.

  The SDK generates the <handlers>/<aspNetCore> pair on publish; keeping them
  here lets the generated file merge with this one instead of replacing it.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!-- The handler, for requests WebDAV would otherwise serve itself. -->
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <modules runAllManagedModulesForAllRequests="false">
        <!-- The module, which is what actually returns the 405. -->
        <remove name="WebDAVModule" />
      </modules>
      <aspNetCore processPath="dotnet" arguments=".\Electronic_Health_Record.Server.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
