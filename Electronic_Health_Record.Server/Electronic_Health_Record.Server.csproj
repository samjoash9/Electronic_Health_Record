<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\electronic_health_record.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:53807</SpaProxyServerUrl>
    <UserSecretsId>0caa0f10-8801-478b-b60e-a750e6d4f85a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.*-*</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\electronic_health_record.client\electronic_health_record.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!--
    The .esproj reference above sets ReferenceOutputAssembly=false, so a publish
    carries none of the SPA's build output: without these targets the deployed
    site serves the API but answers every page request with an empty shell.

    Both targets run on publish only. A dev run is served by the Vite dev server
    through SpaProxy, so building the bundle during an ordinary `dotnet build`
    would cost a minute and produce files nothing reads.
  -->
  <Target Name="PublishSpaBuild" BeforeTargets="ComputeFilesToPublish">
    <Message Importance="high" Text="Building the React client for publish..." />

    <!-- `npm install`, not `npm ci`: ci deletes and recreates node_modules, and
         on a synced or antivirus-scanned checkout that fails with EPERM on the
         native .node binaries while they are locked. install honours the
         lockfile the same way for an up-to-date tree without removing it.
         A CI runner with a clean workspace can safely use `npm ci` instead. -->
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(SpaRoot)" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <Target Name="PublishSpaFiles" AfterTargets="PublishSpaBuild">
    <!-- Globbed inside the target, not in a top-level ItemGroup: dist/ does not
         exist until PublishSpaBuild has run, and item groups outside a target
         are evaluated before any target executes. -->
    <ItemGroup>
      <SpaPublishFiles Include="$(SpaRoot)\dist\**" />
    </ItemGroup>

    <Error
      Condition="'@(SpaPublishFiles)' == ''"
      Text="The client build produced no files in $(SpaRoot)\dist. Publishing would deploy an API with no UI, so the build is stopped here." />

    <ItemGroup>
      <ResolvedFileToPublish Include="@(SpaPublishFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
