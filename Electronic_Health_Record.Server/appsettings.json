{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ElectronicHealthRecordDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    // Key is deliberately absent: it is a secret and must never be committed.
    // Development: dotnet user-secrets set "Jwt:Key" "<base64 of 64 random bytes>"
    // Production:  set the Jwt__Key environment variable on the host.
    // Startup fails fast if it is missing or shorter than 32 bytes.
    "Issuer": "Electronic_Health_Record.Server",
    "Audience": "Electronic_Health_Record.Client",
    "ExpiresInMinutes": 480
  },
  "Seed": {
    "DevFixtures": false
  },
  "EmployeeApi": {
    "BaseUrl": "https://pgas.ph/ihris/api/data/getactiveemployeeinfos/phoformat"
  },
  "AllowedHosts": "*"
}